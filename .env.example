# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Liste de secours uniquement si la table public.admins est momentanément indisponible.
ADMIN_EMAILS=contact@frtp.fr

# Serveur Node.js
NODE_ENV=production
PORT=3000

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://www.frtp.fr

# Email de notification des demandes de contact
CONTACT_MAIL_TO=contact@frtp.fr
CONTACT_MAIL_FROM=contact@frtp.fr

# Canal recommandé pour les notifications du formulaire
RESEND_API_KEY=
RESEND_FROM=FRTP <onboarding@resend.dev>

# SMTP de secours
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@frtp.fr
SMTP_PASSWORD=
